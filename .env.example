# Devin Enterprise API Configuration
# Copy this file to .env and fill in your actual values

# Service User API Key (prefix: cog_)
# Create a Service User in Enterprise Settings > Service Users
# Used for: v3 API (audit logs, RBAC management)
DEVIN_SERVICE_ACCOUNT_API_KEY=cog_your_service_user_key_here

# Personal Admin API Key (prefix: apk_user_)
# Generate from your user profile as an Enterprise Admin
# Used for: v2 API (session details, enterprise sessions)
DEVIN_ADMIN_USER_API_KEY=apk_user_your_admin_key_here
