    "/v1/sessions/{session_id}/message": {
      "post": {
        "summary": "Send a message to a session",
        "description": "Send a message to an active Devin session. The session must be in a running state to receive messages. Returns null on success, or a detail message if the session is already suspended.",
        "operationId": "post_message_to_session_v1_sessions__session_id__message_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
