    "/v1/sessions": {
      "post": {
        "summary": "Create a new session",
        "description": "Create a new Devin session with the specified prompt and configuration options.",
        "operationId": "create_session_endpoint_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        }
      },
      "get": {
        "summary": "List sessions",
        "description": "List all Devin sessions for your organization. Supports pagination and filtering by tags and user email.",
        "operationId": "list_sessions_endpoint_v1_sessions_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "skip",
            "required": false,
            "schema": {
              "type": "integer",
              "nullable": true,
              "title": "Skip"
            }
          },
          {
            "description": "List of tags to filter sessions by.",
            "in": "query",
            "name": "tags",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "nullable": true,
              "description": "List of tags to filter sessions by.",
              "title": "Tags"
            }
          },
          {
            "description": "Filter sessions by the creator's email address.",
            "in": "query",
            "name": "user_email",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true,
              "description": "Filter sessions by the creator's email address.",
              "title": "User Email"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListSessionsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        }
      }
    },
    "/v1/sessions/{session_id}": {
      "get": {
        "summary": "Retrieve details about an existing session",
