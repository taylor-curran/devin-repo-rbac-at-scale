  "components": {
    "schemas": {
      "CreateSessionResponse": {
        "description": "Response body returned when a session is successfully created.",
        "properties": {
          "is_new_session": {
            "type": "boolean",
            "nullable": true
          },
          "session_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "url"
        ],
        "type": "object"
      },
      "SessionSecretInput": {
        "description": "Input model for a session secret provided via API.",
        "properties": {
          "key": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "sensitive": {
            "default": true,
            "type": "boolean"
          },
          "value": {
            "maxLength": 65536,
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "type": "object"
      },
      "FolderResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "created_at"
        ],
        "type": "object"
      },
      "KnowledgeCreatedBy": {
        "description": "Information about who created a knowledge entry.",
        "properties": {
          "full_name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "nullable": true
          },
          "image_url": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "full_name"
        ],
        "type": "object"
      },
      "SecretMetadata": {
        "description": "Metadata about a stored secret.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "enum": [
              "cookie",
              "key-value",
              "dictionary",
              "totp"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "type": "object"
      },
      "ListSessionsResponse": {
        "description": "Response containing a list of sessions.",
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "AllKnowledgeResponse": {
        "properties": {
          "folders": {
            "items": {
              "$ref": "#/components/schemas/FolderResponse"
            },
            "type": "array"
          },
          "knowledge": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "knowledge",
          "folders"
        ],
        "type": "object"
      },
      "DeletePlaybookResponse": {
        "description": "Response for successful playbook deletion.",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "EditTagsResponse": {
        "description": "Response for successful tag update.",
        "properties": {
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "type": "object"
      },
      "PullRequestInfo": {
        "description": "Pull request information associated with a session.",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "KnowledgeResponse": {
        "properties": {
          "body": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "created_by": {
            "$ref": "#/components/schemas/KnowledgeCreatedBy",
            "nullable": true
          },
          "id": {
            "type": "string"
          },
          "macro": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "parent_folder_id": {
            "type": "string",
            "nullable": true
          },
          "pinned_repo": {
            "type": "string",
            "nullable": true
          },
          "trigger_description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "body",
          "trigger_description",
          "id",
          "created_at"
        ],
        "type": "object"
      },
      "DeleteSecretResponse": {
        "description": "Response for successful secret deletion.",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Body_upload_attachment_customer_endpoint_v1_attachments_post": {
        "properties": {
          "file": {
            "format": "binary",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "GetSessionResponse": {
        "description": "Detailed information about an existing session.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "messages": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SessionMessage"
            },
            "type": "array"
          },
          "playbook_id": {
            "type": "string",
            "nullable": true
          },
          "pull_request": {
            "$ref": "#/components/schemas/PullRequestInfo",
            "nullable": true
          },
          "session_id": {
            "type": "string"
          },
          "snapshot_id": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "status_enum": {
            "enum": [
              "working",
              "blocked",
              "expired",
              "finished",
              "suspend_requested",
              "suspend_requested_frontend",
              "resume_requested",
              "resume_requested_frontend",
              "resumed"
            ],
            "type": "string",
            "nullable": true
          },
          "structured_output": {
            "nullable": true,
            "title": "Structured Output"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "status",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "CreatePlaybookRequest": {
